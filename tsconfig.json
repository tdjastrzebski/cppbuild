{
    "compilerOptions": {
        "target": "es6",
        "lib": ["es2017", "es2015", "dom", "es6"],
        "module": "commonjs",
        "sourceMap": true,
        "outDir": "./out",
        "rootDir": ".",
        "esModuleInterop": true,
        "strict": true,
        "declaration": true,
        "skipLibCheck" : true
    },
    "include": [
        "src/**/*.ts",
        "test/tests.ts",
    ],
    "exclude": [
        "node_modules"
    ]
}
